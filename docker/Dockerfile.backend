# backend Dockerfile (Node + Prisma)

# Build stage: install dependencies and generate Prisma client
FROM node:20-alpine AS build
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 g++ make libc6-compat

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci --production=false

# Copy Prisma schema and server
COPY prisma ./prisma
COPY server ./server
COPY .env.example ./

# Generate Prisma client
RUN npm run db:generate || npx prisma generate

# Production stage
FROM node:20-alpine AS production
WORKDIR /app

# Install runtime deps
COPY package.json package-lock.json ./
RUN apk add --no-cache netcat-openbsd && npm ci --production

# Copy prisma client from build
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/prisma ./prisma

# Copy app
COPY server ./server
COPY ImagesSite ./ImagesSite
COPY .env.example ./

# Create uploads directory
RUN mkdir -p /app/ImagesSite

ENV NODE_ENV=production
EXPOSE 3001

# Entrypoint will run migrations and start the server by default
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

CMD ["/usr/local/bin/entrypoint.sh", "node", "server/index.js"]
